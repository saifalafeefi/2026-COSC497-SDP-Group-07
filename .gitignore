# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/
ENV/

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS junk ---
.DS_Store
Thumbs.db
desktop.ini

# --- Dataset (3.8 GB — too big for GitHub) ---
# Download from the UBC PPG dataset source and place at the path below.
Code & Data/

# --- TensorFlow / Keras logs and checkpoints ---
*.ckpt
checkpoints/
logs/
tensorboard/

# --- Jupyter ---
.ipynb_checkpoints/
/docs
/WESAD
/PPG_DaLiA

# large local model artifacts — dashboard + device run ae_int8.tflite (4 MB, tracked)
anomaly/saved/ae.keras
anomaly/saved/ae_float32.tflite

# recorded calm from the sensor — personal biometric data, and re-derivable
anomaly/saved/device_calm.npz

# wifi credentials for the board. secrets.h is YOURS and never committed;
# secrets.example.h is the empty template you copy it from and IS committed --
# the sketch does #include "secrets.h" and will not compile until you have made
# one, so a fresh clone needs something to copy.
pulse_display/secrets.h
pulse_headless/secrets.h

# editor cruft from the Arduino web IDE
pulse_display/.theia/
pulse_headless/.theia/

# generated from pulse/ and anomaly/static/ by pulse_display/make_web_assets.py,
# which writes one copy into EVERY sketch folder -- an Arduino sketch can only
# include headers that sit beside it, so the two builds each need their own.
# 421 KB that would churn on every UI tweak, and one command rebuilds it --
# but the sketch will NOT compile until you run that command once.
pulse_display/web_assets.h
pulse_headless/web_assets.h

# --- the master's store: subject data, never committed ---
/data

# the control panel exe -- built locally by launcher/build_exe.bat (Windows)
/Pulse Control.exe

# "Pulse Control.app" (the macOS wrapper from launcher/make_app.sh) IS committed
# -- it is ~170 KB and carries no code, so a fresh clone has the icon already.
# What is NOT committed is the frozen standalone bundle, which is 29 MB of
# bundled interpreter and only needed on a Mac with no usable Python.
/Pulse Control (standalone).app/

# iconutil's intermediate; launcher/icon/PulseControl.icns is committed
launcher/icon/PulseControl.iconset/
